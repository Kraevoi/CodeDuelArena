@{
    ViewData["Title"] = "Arena";
}

<div class="text-center">
    <h1 class="display-4 text-danger fw-bold">⚔️ CODE DUEL ARENA</h1>
    <p class="lead text-info">Fix legacy code, hack challenges, destroy opponents.</p>
    
    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card bg-dark border-danger mb-4">
                <div class="card-header bg-danger text-white fw-bold">
                    🔥 YOUR STATS
                </div>
                <div class="card-body" id="userStats">
                    <div class="text-center text-muted">
                        <p>Log in to see your stats</p>
                        <i class="text-info">Click Login button in the top right corner</i>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="duelQueueBtn" class="btn btn-danger w-100">
                        ⚡ JOIN DUEL QUEUE
                    </button>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card bg-dark border-danger">
                <div class="card-header bg-danger text-white fw-bold">
                    📢 REPORT BUG
                </div>
                <div class="card-body">
                    <form method="post" action="/Home/ReportBug">
                        <textarea name="bugText" class="form-control bg-black text-white border-danger" rows="4" placeholder="Describe the issue..."></textarea>
                        <button type="submit" class="btn btn-danger mt-3 w-100">
                            🚨 SUBMIT REPORT
                        </button>
                    </form>
                    @if (TempData["ReportMessage"] != null)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            @TempData["ReportMessage"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-5">
        <h3 class="text-danger fw-bold">🏆 LEADERBOARD</h3>
        <div id="leaderboardTable" class="mt-3">
            <div class="text-center text-muted">Loading...</div>
        </div>
    </div>
</div>