@model List<CodeDuelArena.Models.UserDb>
@{
    ViewData["Title"] = "Leaderboard";
}

<h2 class="text-danger">🏆 LEADERBOARD</h2>

<div class="table-responsive">
    <table class="table table-dark table-striped">
        <thead class="bg-danger text-white">
            <tr>
                <th>#</th>
                <th>PLAYER</th>
                <th>TAG</th>
                <th>⭐ SCORE</th>
                <th>🏆 WINS</th>
                <th>💀 LOSSES</th>
                <th>📅 REGISTERED</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td class="fw-bold">@(i + 1)</td>
                        <td>
                            <a href="/Profile/Index?username=@Model[i].Username" class="text-danger fw-bold text-decoration-none">
                                @Model[i].Username
                            </a>
                        </td>
                        <td>
                            <span class="text-warning">@@@Model[i].Tag</span>
                        </td>
                        <td class="text-danger fw-bold">@Model[i].Score</td>
                        <td>@Model[i].Wins</td>
                        <td>@Model[i].Losses</td>
                        <td>@Model[i].RegisteredAt.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No players yet</td>
                </tr>
            }
        </tbody>
    </table>
</div>