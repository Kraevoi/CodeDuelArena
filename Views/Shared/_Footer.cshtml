<script>
    function toggleSupportWidget() {
        var panel = document.getElementById("supportPanel");
        if (panel.style.display === "none") {
            panel.style.display = "block";
        } else {
            panel.style.display = "none";
        }
    }
    
    function sendSupportMessage() {
        var input = document.getElementById("supportInput");
        var msg = input.value.trim();
        if (!msg) return;
        
        var messagesDiv = document.getElementById("supportMessages");
        messagesDiv.innerHTML += '<div class="support-user-msg"><div class="msg-text">' + escapeHtml(msg) + '</div></div>';
        
        input.value = "";
        
        setTimeout(function() {
            var response = getBotResponse(msg.toLowerCase());
            messagesDiv.innerHTML += '<div class="support-bot-msg"><i class="fas fa-robot"></i><div class="msg-text">' + response + '</div></div>';
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }, 500);
        
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }
    
    function getBotResponse(msg) {
        if (msg.includes("register") || msg.includes("регистрац")) {
            return 'To register, click the <b>Login</b> button in the top right corner and switch to the <b>Registration</b> tab. Choose a username (min 3 characters) and password (min 4 characters).';
        }
        if (msg.includes("duel") || msg.includes("дуэл")) {
            return 'Duels are real-time coding battles! Click <b>Join Duel Queue</b> on the main page. You will be matched with an opponent. Both get the same task — first correct answer wins! Time limit: 60 seconds.';
        }
        if (msg.includes("point") || msg.includes("очк") || msg.includes("score")) {
            return 'You earn points by:<br>• Completing quests (100-300 pts each)<br>• Winning duels (+100 pts)<br>• Completing daily quests<br>• Unlocking achievements';
        }
        if (msg.includes("bug") || msg.includes("баг") || msg.includes("report") || msg.includes("жалоб")) {
            return 'To report a bug, use the <b>Report Bug</b> form on the main page, or contact our support bot on Telegram.';
        }
        if (msg.includes("operator") || msg.includes("оператор") || msg.includes("human") || msg.includes("человек")) {
            return 'I will connect you with a human operator. Please contact us via Telegram bot and use the <b>/support</b> command. An operator will respond shortly.';
        }
        if (msg.includes("contact") || msg.includes("контакт") || msg.includes("support") || msg.includes("поддержк")) {
            return 'You can reach us via:<br>• Telegram bot<br>• Email: admin@codeduel.com<br>• Support widget (you are using it now!)';
        }
        
        return 'I am not sure I understand. Try asking about:<br>• <b>How to register</b><br>• <b>How duels work</b><br>• <b>How to earn points</b><br>• <b>Report a bug</b><br>• <b>Contact operator</b><br><br>Or type <b>operator</b> to speak with a human.';
    }
    
    function showPolicy(type) {
        var title, body;
        
        if (type === 'privacy') {
            title = 'Privacy Policy';
            body = '<h5>1. Information We Collect</h5><p>We collect username, email (optional), and game statistics (scores, wins, losses). Avatar images are stored on our servers.</p><h5>2. How We Use Information</h5><p>Your data is used to provide game services, display leaderboards, and send notifications (if subscribed).</p><h5>3. Data Storage</h5><p>Data is stored on secure servers provided by Render. We use PostgreSQL databases with encrypted connections.</p><h5>4. Third Parties</h5><p>We do not sell or share your data with third parties.</p><h5>5. Contact</h5><p>For privacy concerns, contact admin@codeduel.com.</p>';
        } else if (type === 'terms') {
            title = 'Terms of Service';
            body = '<h5>1. Acceptance</h5><p>By using CodeDuel Arena, you agree to these terms.</p><h5>2. User Conduct</h5><p>No cheating, exploiting bugs, or harassing other users. Violations result in account suspension.</p><h5>3. Intellectual Property</h5><p>Code submitted in quests and duels remains your property. Platform code is protected.</p><h5>4. Service Availability</h5><p>We strive for 99% uptime but do not guarantee uninterrupted service.</p><h5>5. Changes</h5><p>Terms may be updated. Continued use constitutes acceptance.</p>';
        } else {
            title = 'Cookie Policy';
            body = '<h5>1. What Are Cookies</h5><p>Cookies are small text files stored on your device to remember preferences.</p><h5>2. Cookies We Use</h5><p>• <b>auth_user</b> — keeps you logged in<br>• <b>user_theme</b> — remembers your theme preference<br>• <b>admin_auth</b> — admin session</p><h5>3. Managing Cookies</h5><p>You can disable cookies in browser settings, but some features may not work.</p>';
        }
        
        document.getElementById("policyTitle").textContent = title;
        document.getElementById("policyBody").innerHTML = body;
        var modal = new bootstrap.Modal(document.getElementById("policyModal"));
        modal.show();
    }
    
    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>