<div class="modal fade" id="authModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title">🔐 Login / Register</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" id="authTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active text-dark bg-danger" data-bs-toggle="tab" data-bs-target="#loginTab">Login</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-white" data-bs-toggle="tab" data-bs-target="#registerTab">Register</button>
                    </li>
                </ul>
                <div class="tab-content mt-3">
                    <!-- Login Tab -->
                    <div class="tab-pane fade show active" id="loginTab">
                        <input type="text" id="loginUsername" class="form-control bg-black text-white border-danger mb-2" placeholder="Username">
                        <input type="password" id="loginPassword" class="form-control bg-black text-white border-danger mb-2" placeholder="Password">
                        <div class="form-check mb-2">
                            <input type="checkbox" id="loginRemember" class="form-check-input">
                            <label class="form-check-label">Remember me</label>
                        </div>
                        <button id="loginBtn" class="btn btn-danger w-100">Login</button>
                    </div>
                    <!-- Register Tab -->
                    <div class="tab-pane fade" id="registerTab">
                        <input type="text" id="regUsername" class="form-control bg-black text-white border-danger mb-2" placeholder="Username (min 3 characters)">
                        <input type="text" id="regTag" class="form-control bg-black text-white border-danger mb-2" placeholder="Tag (unique, 3-20 chars, a-z 0-9 _)">
                        <small class="text-muted d-block mb-2">Tag cannot be changed later. It's your unique identifier.</small>
                        <input type="email" id="regEmail" class="form-control bg-black text-white border-danger mb-2" placeholder="Email (optional)">
                        <input type="password" id="regPassword" class="form-control bg-black text-white border-danger mb-2" placeholder="Password (min 4 characters)">
                        <div class="form-check mb-2">
                            <input type="checkbox" id="regRemember" class="form-check-input">
                            <label class="form-check-label">Remember me</label>
                        </div>
                        <button id="registerBtnModal" class="btn btn-danger w-100">Register</button>
                    </div>
                </div>
                <div id="authError" class="alert alert-danger mt-3 d-none"></div>
            </div>
        </div>
    </div>
</div>