@model CodeDuelArena.Models.UserDb
@{
    ViewData["Title"] = "Profile";
    var settings = ViewBag.Settings as CodeDuelArena.Models.UserSettings;
    var league = ViewBag.League as CodeDuelArena.Models.UserLeague;
    var achievements = ViewBag.Achievements as List<CodeDuelArena.Models.UserAchievement>;
    var isOwnProfile = ViewBag.IsOwnProfile;
}

<div class="profile-container">
    <div class="profile-header mb-4">
        <div class="profile-cover"></div>
        <div class="profile-info">
            <div class="profile-avatar-wrapper">
               <img src="/Profile/Avatar?username=@Model.Username&v=@DateTime.Now.Ticks" 
                    class="profile-avatar" 
                    alt="@Model.Username" />
                    style="width:120px;height:120px;border-radius:20px;object-fit:cover;border:4px solid #1a1a2e;" />
                @if (isOwnProfile)
                {
                    <form method="post" enctype="multipart/form-data" action="/Profile/UploadAvatar" class="avatar-upload-form">
                    <label for="avatarUpload" class="avatar-upload-btn">
                    <i class="fas fa-camera"></i>
                </label>
                <input type="file" id="avatarUpload" name="avatar" accept="image/*" onchange="this.form.submit()" hidden />
                </form>
                }
            </div>

            <div class="profile-details">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h1 class="profile-username">
                        @Model.Username
                        @if (Model.IsAdmin)
                        {
                            <span class="admin-badge-inline">ADM</span>
                        }
                    </h1>
                    <span class="league-badge @(league?.League?.ToLower() ?? "bronze")">
                        @(league?.League switch { "Diamond" => "💎", "Platinum" => "🔮", "Gold" => "🥇", "Silver" => "⚪", _ => "🪙" })
                        @(league?.League ?? "Bronze") League
                    </span>
                </div>

                <div class="profile-stats">
                    <div class="stat-item">
                        <span class="stat-value">@Model.Score.ToString("N0")</span>
                        <span class="stat-label">Points</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-value text-success">@Model.Wins</span>
                        <span class="stat-label">Wins</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-value text-danger">@Model.Losses</span>
                        <span class="stat-label">Losses</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-value text-info">@(Model.Wins + Model.Losses > 0 ? Math.Round((double)Model.Wins / (Model.Wins + Model.Losses) * 100, 1).ToString("F1") : "0")%</span>
                        <span class="stat-label">Win Rate</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card profile-sidebar-card">
                <div class="card-header"><i class="fas fa-user-circle me-2"></i>Account Info</div>
                <div class="card-body">
                    <ul class="info-list">
                        <li><i class="fas fa-tag"></i><span>Tag: @@@Model.Tag</span></li>
                        <li><i class="fas fa-envelope"></i><span>@(string.IsNullOrEmpty(Model.Email) ? "Email not set" : Model.Email)</span></li>
                        <li><i class="fas fa-calendar-alt"></i><span>Registered: @Model.RegisteredAt.ToString("dd.MM.yyyy")</span></li>
                        <li><i class="fas fa-clock"></i><span>Last Login: @Model.LastLogin.ToString("dd.MM.yyyy HH:mm")</span></li>
                        <li><i class="fas fa-tasks"></i><span>Quests Completed: @(Model.CompletedQuests?.Count ?? 0)</span></li>
                    </ul>
                </div>
            </div>
            <div class="card profile-sidebar-card mt-4">
                <div class="card-header"><i class="fas fa-trophy me-2"></i>Achievements</div>
                <div class="card-body">
                    @if (achievements != null && achievements.Any())
                    {
                        <div class="achievements-grid">
                            @foreach (var ach in achievements)
                            {
                                <div class="achievement-item">
                                    <div class="achievement-icon">@ach.Achievement?.Icon</div>
                                    <div class="achievement-info">
                                        <div class="achievement-name">@ach.Achievement?.Name</div>
                                        <div class="achievement-desc">@ach.Achievement?.Description</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No achievements yet. Keep playing!</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card profile-main-card">
                <div class="card-header"><i class="fas fa-chart-bar me-2"></i>Performance Overview</div>
                <div class="card-body">
                    <div class="performance-bar">
                        <div class="performance-label">Win Rate</div>
                        <div class="progress-wrapper">
                            <div class="progress"><div class="progress-bar bg-success" style="width: @(Model.Wins + Model.Losses > 0 ? Math.Round((double)Model.Wins / (Model.Wins + Model.Losses) * 100, 1) : 0)%"></div></div>
                            <span class="progress-value">@(Model.Wins + Model.Losses > 0 ? Math.Round((double)Model.Wins / (Model.Wins + Model.Losses) * 100, 1).ToString("F1") : "0")%</span>
                        </div>
                    </div>
                    <div class="performance-bar">
                        <div class="performance-label">Score Progress</div>
                        <div class="progress-wrapper">
                            <div class="progress"><div class="progress-bar bg-warning" style="width: @(Math.Min(100, Model.Score / 20))%"></div></div>
                            <span class="progress-value">@Model.Score.ToString("N0") pts</span>
                        </div>
                    </div>
                    <div class="duel-history mt-4">
                        <h5 class="mb-3"><i class="fas fa-swords me-2"></i>Recent Activity</h5>
                        <div class="ratio-chart">
                            <div class="ratio-item wins-ratio"><div class="ratio-circle"><span>@Model.Wins</span></div><span>Wins</span></div>
                            <div class="ratio-divider">vs</div>
                            <div class="ratio-item losses-ratio"><div class="ratio-circle"><span>@Model.Losses</span></div><span>Losses</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-container { max-width: 1100px; margin: 0 auto; padding: 20px 0; }
    .profile-header { background: linear-gradient(145deg, #1a1a2e, #16213e); border-radius: 20px; overflow: hidden; border: 1px solid rgba(255, 107, 107, 0.2); }
    .profile-cover { height: 140px; background: linear-gradient(135deg, #ff6b6b 0%, #ff4444 50%, #ffd700 100%); }
    .profile-info { display: flex; align-items: flex-end; padding: 0 30px 30px; margin-top: -60px; gap: 25px; }
    .profile-avatar-wrapper { position: relative; flex-shrink: 0; }
    .profile-avatar { width: 120px; height: 120px; border-radius: 20px; object-fit: cover; border: 4px solid #1a1a2e; box-shadow: 0 4px 20px rgba(0,0,0,0.3); background: #dc3545; }
    .avatar-upload-form { position: absolute; bottom: -5px; right: -5px; }
    .avatar-upload-btn { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #ff6b6b, #ff4444); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; border: 3px solid #1a1a2e; color: #fff; font-size: 0.85rem; }
    .avatar-upload-btn:hover { transform: scale(1.1); box-shadow: 0 0 15px rgba(255, 107, 107, 0.5); }
    .profile-details { padding-bottom: 5px; }
    .profile-username { font-size: 1.8rem; font-weight: 700; margin: 0; color: #fff; }
    .admin-badge-inline { background: linear-gradient(135deg, #ffd700, #ff8c00); color: #000; padding: 3px 10px; border-radius: 8px; font-size: 0.65rem; font-weight: 800; letter-spacing: 2px; vertical-align: middle; margin-left: 8px; }
    .league-badge { padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 6px; }
    .league-badge.bronze { background: rgba(205, 127, 50, 0.2); color: #cd7f32; border: 1px solid rgba(205, 127, 50, 0.4); }
    .league-badge.silver { background: rgba(192, 192, 192, 0.2); color: #c0c0c0; border: 1px solid rgba(192, 192, 192, 0.4); }
    .league-badge.gold { background: rgba(255, 215, 0, 0.2); color: #ffd700; border: 1px solid rgba(255, 215, 0, 0.4); }
    .league-badge.platinum { background: rgba(0, 255, 255, 0.2); color: #0ff; border: 1px solid rgba(0, 255, 255, 0.4); }
    .league-badge.diamond { background: rgba(185, 55, 255, 0.2); color: #b937ff; border: 1px solid rgba(185, 55, 255, 0.4); }
    .profile-stats { display: flex; align-items: center; gap: 20px; margin-top: 15px; background: rgba(0,0,0,0.3); padding: 15px 20px; border-radius: 14px; flex-wrap: wrap; }
    .stat-item { text-align: center; }
    .stat-value { display: block; font-size: 1.3rem; font-weight: 700; color: #fff; }
    .stat-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .stat-divider { width: 1px; height: 30px; background: rgba(255,255,255,0.1); }
    .profile-sidebar-card, .profile-main-card { background: linear-gradient(145deg, #1a1a2e, #16213e); border: 1px solid rgba(255, 107, 107, 0.2); border-radius: 16px; overflow: hidden; }
    .profile-sidebar-card .card-header, .profile-main-card .card-header { background: linear-gradient(135deg, rgba(255, 107, 107, 0.2), rgba(255, 68, 68, 0.1)); border-bottom: 1px solid rgba(255, 107, 107, 0.3); color: #fff; font-weight: 600; padding: 14px 20px; }
    .info-list { list-style: none; padding: 0; margin: 0; }
    .info-list li { display: flex; align-items: center; gap: 12px; padding: 12px 0; color: #c0c0c0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .info-list li:last-child { border-bottom: none; }
    .info-list li i { width: 20px; color: #ff6b6b; text-align: center; }
    .achievements-grid { display: flex; flex-direction: column; gap: 10px; }
    .achievement-item { display: flex; align-items: center; gap: 14px; padding: 12px; background: rgba(0,0,0,0.2); border-radius: 12px; }
    .achievement-item:hover { background: rgba(255, 107, 107, 0.08); }
    .achievement-icon { font-size: 1.8rem; flex-shrink: 0; }
    .achievement-name { font-weight: 600; color: #fff; font-size: 0.9rem; }
    .achievement-desc { font-size: 0.75rem; color: #888; }
    .performance-bar { margin-bottom: 20px; }
    .performance-label { color: #888; font-size: 0.85rem; margin-bottom: 8px; font-weight: 600; }
    .progress-wrapper { display: flex; align-items: center; gap: 14px; }
    .progress { flex-grow: 1; height: 10px; background: rgba(0,0,0,0.4); border-radius: 10px; overflow: hidden; }
    .progress-bar { border-radius: 10px; }
    .progress-value { font-weight: 700; color: #fff; font-size: 0.9rem; min-width: 60px; text-align: right; }
    .ratio-chart { display: flex; align-items: center; justify-content: center; gap: 30px; }
    .ratio-item { text-align: center; }
    .ratio-circle { width: 70px; height: 70px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
    .wins-ratio .ratio-circle { background: rgba(40, 167, 69, 0.2); border: 2px solid rgba(40, 167, 69, 0.5); color: #28a745; }
    .losses-ratio .ratio-circle { background: rgba(220, 53, 69, 0.2); border: 2px solid rgba(220, 53, 69, 0.5); color: #dc3545; }
    .ratio-item span:last-child { color: #888; font-size: 0.8rem; }
    .ratio-divider { font-size: 1.2rem; font-weight: 700; color: #555; }
</style>