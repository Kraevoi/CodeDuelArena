@{
    ViewData["Title"] = "Messages";
}

<div class="chat-app">
    <!-- Список чатов -->
    <div class="chat-sidebar">
        <div class="chat-sidebar-header">
            <h5><i class="fas fa-comments me-2"></i>Messages</h5>
            <button class="btn btn-sm btn-outline-danger" onclick="showNewChat()">
                <i class="fas fa-plus"></i> New
            </button>
        </div>
        <div class="chat-search">
            <input type="text" id="chatSearch" class="form-control-sm bg-black text-white border-danger w-100" placeholder="Search chats..." onkeyup="filterChats()">
        </div>
        <div class="chat-list" id="chatList">
            <div class="text-center text-muted py-4">Loading...</div>
        </div>
    </div>
    
    <!-- Окно чата -->
    <div class="chat-main">
        <div class="chat-header" id="chatHeader">
            <div class="text-muted text-center py-5">
                <i class="fas fa-comments fa-3x mb-3 d-block"></i>
                Select a chat to start messaging
            </div>
        </div>
        <div class="chat-messages" id="chatMessages">
        </div>
        <div class="chat-input" id="chatInputArea" style="display:none;">
            <input type="text" id="messageInput" class="form-control bg-black text-white border-danger" placeholder="Type a message..." onkeypress="if(event.key==='Enter')sendMessage()">
            <button class="btn btn-danger" onclick="sendMessage()">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

<!-- Модалка нового чата -->
<div class="modal fade" id="newChatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title">New Message</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="userSearchInput" class="form-control bg-black text-white border-danger mb-3" placeholder="Search by username or tag..." onkeyup="searchUsers()">
                <div id="userSearchResults"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js"></script>
}

<style>
    .chat-app {
        display: flex;
        height: calc(100vh - 140px);
        background: linear-gradient(145deg, #1a1a2e, #16213e);
        border: 1px solid rgba(255, 107, 107, 0.2);
        border-radius: 16px;
        overflow: hidden;
    }
    
    .chat-sidebar {
        width: 320px;
        border-right: 1px solid rgba(255, 107, 107, 0.2);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }
    
    .chat-sidebar-header {
        padding: 16px;
        border-bottom: 1px solid rgba(255, 107, 107, 0.2);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .chat-sidebar-header h5 {
        color: #ff6b6b;
        margin: 0;
        font-weight: 700;
    }
    
    .chat-search {
        padding: 10px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .chat-list {
        flex: 1;
        overflow-y: auto;
    }
    
    .chat-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        cursor: pointer;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.2s;
    }
    
    .chat-item:hover {
        background: rgba(255, 107, 107, 0.05);
    }
    
    .chat-item.active {
        background: rgba(255, 107, 107, 0.1);
        border-left: 3px solid #dc3545;
    }
    
    .chat-item .chat-avatar {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.2rem;
        color: #fff;
        flex-shrink: 0;
    }
    
    .chat-item .chat-info {
        flex: 1;
        min-width: 0;
    }
    
    .chat-item .chat-name {
        font-weight: 600;
        color: #fff;
        font-size: 0.9rem;
    }
    
    .chat-item .chat-preview {
        color: #888;
        font-size: 0.8rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .chat-item .chat-meta {
        text-align: right;
        flex-shrink: 0;
    }
    
    .chat-item .chat-time {
        font-size: 0.7rem;
        color: #666;
    }
    
    .chat-item .chat-unread {
        background: #dc3545;
        color: #fff;
        border-radius: 10px;
        padding: 2px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        margin-top: 4px;
        display: inline-block;
    }
    
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    
    .chat-header {
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 107, 107, 0.2);
        font-weight: 600;
        color: #fff;
    }
    
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .message-bubble {
        max-width: 70%;
        padding: 10px 16px;
        border-radius: 16px;
        font-size: 0.9rem;
        line-height: 1.4;
        word-wrap: break-word;
    }
    
    .message-mine {
        align-self: flex-end;
        background: #dc3545;
        color: #fff;
        border-bottom-right-radius: 4px;
    }
    
    .message-other {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.08);
        color: #e0e0e0;
        border-bottom-left-radius: 4px;
    }
    
    .message-time {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.5);
        margin-top: 4px;
        text-align: right;
    }
    
    .chat-input {
        display: flex;
        gap: 10px;
        padding: 14px 20px;
        border-top: 1px solid rgba(255, 107, 107, 0.2);
    }
    
    .chat-input input {
        flex: 1;
        padding: 10px 16px;
        border-radius: 20px;
    }
    
    .chat-input button {
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .user-search-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.2s;
    }
    
    .user-search-item:hover {
        background: rgba(255, 107, 107, 0.1);
    }
    
    .user-search-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #fff;
    }
    
    @@media (max-width: 768px) {
        .chat-app { flex-direction: column; height: calc(100vh - 100px); }
        .chat-sidebar { width: 100%; max-height: 40%; }
        .chat-main { flex: 1; }
        .message-bubble { max-width: 85%; }
    }
</style>