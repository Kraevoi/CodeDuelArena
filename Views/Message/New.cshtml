@{
    ViewData["Title"] = "New Message";
}

<div class="container py-4">
    <h2 class="text-danger fw-bold mb-4"><i class="fas fa-pen-to-square me-2"></i>New Message</h2>
    
    <div class="row">
        <div class="col-lg-7">
            <div class="card premium-card">
                <div class="card-header"><i class="fas fa-edit me-2"></i>Compose</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label-custom">Search User</label>
                        <input type="text" id="userSearch" class="form-control-custom" placeholder="Type username or tag...">
                        <div id="searchResults" class="search-results mt-1" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-custom">Recipient</label>
                        <input type="text" id="toUser" class="form-control-custom" placeholder="Selected user..." readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-custom">Message</label>
                        <textarea id="messageText" class="form-control-custom" rows="5" placeholder="Type your message..."></textarea>
                    </div>
                    <button id="sendBtn" class="btn btn-danger w-100">
                        <i class="fas fa-paper-plane me-2"></i>Send Message
                    </button>
                    <div id="sendResult" class="mt-3" style="display:none;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card premium-card">
                <div class="card-header"><i class="fas fa-users me-2"></i>All Users</div>
                <div class="card-body p-0">
                    <input type="text" id="allUsersSearch" class="form-control-custom m-2" style="width: calc(100% - 16px);" placeholder="Filter users...">
                    <div id="allUsersList" style="max-height: 500px; overflow-y: auto;">
                        <div class="text-center text-muted py-4">Loading...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/messages.js"></script>
}

<style>
    .premium-card { background: linear-gradient(145deg, #1a1a2e, #16213e); border: 1px solid rgba(255, 107, 107, 0.2); border-radius: 16px; overflow: hidden; }
    .premium-card .card-header { background: linear-gradient(135deg, rgba(255, 107, 107, 0.2), rgba(255, 68, 68, 0.1)); border-bottom: 1px solid rgba(255, 107, 107, 0.3); color: #fff; font-weight: 600; padding: 14px 20px; }
    .form-label-custom { color: #c0c0c0; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
    .form-control-custom { width: 100%; padding: 12px 16px; background: #0a0a1a; border: 1px solid rgba(255, 107, 107, 0.3); border-radius: 10px; color: #fff; font-size: 0.95rem; }
    .form-control-custom:focus { outline: none; border-color: #ff6b6b; box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.08); }
    .search-results { background: #1a1a2e; border: 1px solid rgba(255, 107, 107, 0.3); border-radius: 10px; max-height: 250px; overflow-y: auto; }
    .search-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; cursor: pointer; color: #c0c0c0; transition: all 0.2s; }
    .search-item:hover { background: rgba(255, 107, 107, 0.1); color: #fff; }
    .user-list-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; cursor: pointer; color: #c0c0c0; transition: all 0.2s; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .user-list-item:hover { background: rgba(255, 107, 107, 0.08); color: #fff; }
    .user-list-item:last-child { border-bottom: none; }
    .user-avatar-xs { width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, #ff6b6b, #ff4444); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; color: #fff; flex-shrink: 0; }
    .alert-success-custom { background: rgba(40, 167, 69, 0.15); border: 1px solid rgba(40, 167, 69, 0.4); color: #28a745; padding: 12px 16px; border-radius: 10px; }
    .alert-error-custom { background: rgba(220, 53, 69, 0.15); border: 1px solid rgba(220, 53, 69, 0.4); color: #dc3545; padding: 12px 16px; border-radius: 10px; }
</style>