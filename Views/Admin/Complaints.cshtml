@model List<CodeDuelArena.Models.Complaint>
@{
    ViewData["Title"] = "Complaints";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="background: linear-gradient(135deg, #ff6b6b, #ff4444); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            <i class="fas fa-exclamation-triangle me-2"></i>User Complaints
        </h2>
        <a href="/Admin/Dashboard" class="btn btn-outline-light btn-hover">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <div class="card premium-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-bug me-2"></i>All Reports</span>
            <span class="badge bg-gradient-pink">@Model.Count Reports</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th style="width: 130px;">User</th>
                            <th>Message</th>
                            <th style="width: 130px;">Date</th>
                            <th style="width: 80px;">Status</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td><span class="id-badge">#@c.Id</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2">@(c.UserName.Length > 0 ? c.UserName[0] : '?')</div>
                                            <span>@c.UserName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="message-cell">
                                            @c.Message
                                        </div>
                                    </td>
                                    <td>@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (c.IsRead)
                                        {
                                            <span class="badge bg-success">Read</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">New</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            @if (!c.IsRead)
                                            {
                                                <button class="btn btn-sm btn-mark-read" onclick="markRead(@c.Id)" title="Mark as read">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-delete" onclick="deleteComplaint(@c.Id)" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No complaints found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function markRead(id) {
    $.post("/Admin/MarkRead", { id: id }, function(res) {
        if(res.success) location.reload();
    });
}

function deleteComplaint(id) {
    if(confirm("Are you sure you want to delete this complaint?")) {
        $.post("/Admin/DeleteComplaint", { id: id }, function(res) {
            if(res.success) location.reload();
        });
    }
}
</script>

<style>
    .premium-card {
        background: linear-gradient(145deg, #1a1a2e, #16213e);
        border: 1px solid rgba(255, 107, 107, 0.2);
        border-radius: 16px;
    }
    .premium-card .card-header {
        background: linear-gradient(135deg, rgba(255, 107, 107, 0.2), rgba(255, 68, 68, 0.1));
        border-bottom: 1px solid rgba(255, 107, 107, 0.3);
        color: #fff;
        font-weight: 600;
        border-radius: 16px 16px 0 0;
        padding: 14px 20px;
    }
    
    .premium-table {
        color: #e0e0e0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }
    .premium-table thead th {
        background: linear-gradient(135deg, #1a1a2e, #0f0f23);
        color: #ff6b6b;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        padding: 14px 12px;
        border-bottom: 2px solid rgba(255, 107, 107, 0.4);
        white-space: nowrap;
    }
    .premium-table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .premium-table tbody tr:hover {
        background: rgba(255, 107, 107, 0.04);
    }
    .premium-table tbody td {
        padding: 14px 12px;
        vertical-align: middle;
        color: #c0c0c0;
    }
    
    .message-cell {
        max-width: 350px;
        word-wrap: break-word;
        white-space: pre-wrap;
        line-height: 1.5;
    }
    
    .id-badge {
        background: rgba(255, 107, 107, 0.15);
        color: #ff6b6b;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }
    
    .avatar-sm {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(135deg, #ff6b6b, #ff4444);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.8rem;
        color: #fff;
        flex-shrink: 0;
    }
    
    .bg-gradient-pink {
        background: linear-gradient(135deg, #ff6b6b, #ff4444);
        color: #fff;
        font-weight: 600;
    }
    
    .btn-mark-read {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        transition: all 0.2s;
    }
    .btn-mark-read:hover {
        background: rgba(40, 167, 69, 0.35);
        color: #2ecc71;
    }
    
    .btn-delete {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        transition: all 0.2s;
    }
    .btn-delete:hover {
        background: rgba(220, 53, 69, 0.35);
        color: #ff4444;
    }
    
    .btn-outline-light.btn-hover {
        border: 1px solid rgba(255,255,255,0.25);
        color: #c0c0c0;
        background: transparent;
        padding: 10px 18px;
        border-radius: 10px;
        transition: all 0.3s;
    }
    .btn-outline-light.btn-hover:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.4);
        color: #fff;
    }
</style>